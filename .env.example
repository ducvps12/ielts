NODE_ENV=development
APP_URL=http://localhost:3000
ADMIN_URL=http://localhost:3001
API_URL=http://localhost:4000
NEXT_PUBLIC_API_URL=http://localhost:4000/api/v1
PORT=4000

POSTGRES_USER=levelup
POSTGRES_PASSWORD=levelup
POSTGRES_DB=levelup
DATABASE_URL=postgresql://levelup:levelup@localhost:5432/levelup?schema=public

REDIS_URL=redis://localhost:6379

S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=levelup-local
S3_ACCESS_KEY=minio
S3_SECRET_KEY=change-me-now

MAIL_HOST=localhost
MAIL_PORT=1025
MAIL_FROM=LevelUp <no-reply@levelup.local>

TELEGRAM_BOT_TOKEN=
SESSION_SECRET=replace-with-at-least-32-random-characters
AUTH_SESSION_COOKIE_NAME=levelup_session
AUTH_CSRF_COOKIE_NAME=levelup_csrf
AUTH_SESSION_TTL_HOURS=12
AUTH_REMEMBER_TTL_DAYS=30
AUTH_TOKEN_TTL_MINUTES=30
AUTH_DEV_TOKENS_ENABLED=true
