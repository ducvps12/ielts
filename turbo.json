{
  "$schema": "https://turbo.build/schema.json",
  "globalEnv": [
    "NODE_ENV",
    "APP_URL",
    "ADMIN_URL",
    "API_URL",
    "NEXT_PUBLIC_API_URL",
    "PORT",
    "DATABASE_URL",
    "REDIS_URL",
    "S3_ENDPOINT",
    "S3_REGION",
    "S3_BUCKET",
    "S3_ACCESS_KEY",
    "S3_SECRET_KEY",
    "MAIL_HOST",
    "MAIL_PORT",
    "MAIL_FROM",
    "TELEGRAM_BOT_TOKEN",
    "SESSION_SECRET",
    "AUTH_SESSION_COOKIE_NAME",
    "AUTH_CSRF_COOKIE_NAME",
    "AUTH_SESSION_TTL_HOURS",
    "AUTH_REMEMBER_TTL_DAYS",
    "AUTH_TOKEN_TTL_MINUTES",
    "AUTH_DEV_TOKENS_ENABLED"
  ],
  "tasks": {
    "dev": { "cache": false, "persistent": true },
    "build": { "dependsOn": ["^build"], "outputs": [".next/**", "dist/**"] },
    "lint": { "dependsOn": ["^build", "^lint"] },
    "typecheck": { "dependsOn": ["^build", "^typecheck"] },
    "test": { "dependsOn": ["^build", "^test"], "outputs": ["coverage/**"] },
    "test:integration": { "dependsOn": ["^build"], "cache": false },
    "test:e2e": { "dependsOn": ["build"], "cache": false }
  }
}
